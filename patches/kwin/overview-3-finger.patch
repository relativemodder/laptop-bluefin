     effects->registerTouchpadPinchShortcut(opposite(direction), fingerCount, m_state->deactivateAction(), m_state->regressCallback());
 }
 
-void EffectTogglableGesture::addTouchpadSwipeGesture(SwipeDirection direction, uint fingerCount)
+static std::function<void(qreal progress)> filterProgress(std::function<void(qreal progress)> callback, const std::function<bool()> &predicate)
 {
-    effects->registerTouchpadSwipeShortcut(direction, fingerCount, m_state->activateAction(), m_state->progressCallback());
-    effects->registerTouchpadSwipeShortcut(opposite(direction), fingerCount, m_state->deactivateAction(), m_state->regressCallback());
+    if (!predicate) {
+        return callback;
+    }
+    return [callback, predicate](qreal progress) {
+        if (predicate()) {
+            callback(progress);
+        }
+    };
+}
+
+void EffectTogglableGesture::addTouchpadSwipeGesture(SwipeDirection direction, uint fingerCount, std::function<bool()> predicate)
+{
+    effects->registerTouchpadSwipeShortcut(direction, fingerCount, m_state->activateAction(), filterProgress(m_state->progressCallback(), predicate));
+    effects->registerTouchpadSwipeShortcut(opposite(direction), fingerCount, m_state->deactivateAction(), filterProgress(m_state->regressCallback(), predicate));
 }
 
