diff --git a/src/swipetracker.h b/src/swipetracker.h
new file mode 100644
index 0000000..97d8205
--- /dev/null
+++ b/src/swipetracker.h
@@ -0,0 +1,119 @@
+/*
+    KWin - the KDE window manager
+    This file is part of the KDE project.
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#pragma once
+
+#include <QPointF>
+
+#include <chrono>
+#include <vector>
+
+namespace KWin
+{
+
+/**
+ * Keeps track of the recent movement of a swipe gesture so that the velocity of the fingers at
+ * the moment they are lifted can be estimated.
+ *
+ * This is a port of niri's SwipeTracker. The idea is that a gesture should not be judged by how
+ * far the fingers travelled, but by where the gesture would coast to a halt if the fingers kept
+ * decelerating the way they already are. Only the last 150 ms of the gesture are taken into
+ * account, so a gesture that came to rest before the fingers were lifted is not mistaken for a
+ * fling.
+ */
+class SwipeTracker
+{
+public:
+    /**
+     * How far back in time the velocity estimation reaches.
+     */
+    static constexpr std::chrono::milliseconds s_historyWindow = std::chrono::milliseconds(150);
+
+    /**
+     * How much longer, in seconds, the gesture would keep sliding after the fingers are lifted.
+     *
+     * This is the closed form of niri's deceleration model, in which the speed drops by a factor
+     * of 0.997 every millisecond: coast = velocity / (1000 * -ln(0.997)).
+     */
+    static constexpr qreal s_flingCoastSeconds = 0.3328331;
+
+    /**
+     * Records the position of the gesture at the current time.
+     */
+    void push(const QPointF &value)
+    {
+        push(value, now());
+    }
+
+    /**
+     * Records the position of the gesture at the given @a time, in milliseconds.
+     */
+    void push(const QPointF &value, qint64 time)
+    {
+        m_samples.push_back({value, time});
+        // Drop everything that is too old to describe how the fingers are moving right now.
+        // This also discards leftovers of a previous gesture.
+        while (m_samples.size() > 1 && m_samples.front().time < time - s_historyWindow.count()) {
+            m_samples.erase(m_samples.begin());
+        }
+    }
+
+    /**
+     * @returns the velocity of the gesture in units per second, based on the samples collected
+     * so far and the time elapsed since the oldest of them.
+     */
+    QPointF velocity() const
+    {
+        return velocity(now());
+    }
+
+    /**
+     * @returns the velocity of the gesture in units per second at the given @a time, in
+     * milliseconds. The idle time between the last recorded sample and @a time is accounted for,
+     * so releasing a gesture long after it stalled yields no velocity.
+     */
+    QPointF velocity(qint64 time) const
+    {
+        if (m_samples.size() < 2) {
+            return QPointF();
+        }
+        const Sample &first = m_samples.front();
+        const Sample &last = m_samples.back();
+        const qreal elapsed = (time - first.time) / 1000.0;
+        if (elapsed <= 0.) {
+            return QPointF();
+        }
+        return (last.value - first.value) / elapsed;
+    }
+
+    /**
+     * Forgets everything that has been recorded so far.
+     */
+    void reset()
+    {
+        m_samples.clear();
+    }
+
+    /**
+     * @returns the current monotonic time in milliseconds.
+     */
+    static qint64 now()
+    {
+        return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    }
+
+private:
+    struct Sample
+    {
+        QPointF value;
+        qint64 time;
+    };
+
+    std::vector<Sample> m_samples;
+};
+
+}
